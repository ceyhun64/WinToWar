{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Admin": {
    "AccessKey": "dev-admin-key"
  },
  "Payment": {
    "CommissionRate": 0.10,
    "MinDepositUsd": 1.00,
    "MinWithdrawalUsd": 1.00,
    "PriceCacheFreshSeconds": 30,
    "PriceCacheStaleMaxSeconds": 300,
    "PriceQuoteValiditySeconds": 900,
    "PriceOracleTimeoutSeconds": 5,
    "PaymentToleranceRate": 0.01,
    "RefundOverpaymentThresholdUsd": 1.00,
    "RequiredConfirmations": 1,
    "WebhookSignatureHeader": "BTCPay-Sig",
    "WebhookMaxAgeSeconds": 300,
    "PayoutRetryCount": 5,
    "PayoutRetryBaseDelaySeconds": 10,
    "PayoutRetryJitterSeconds": 5,
    "RefundRetryCount": 5,
    "RefundRetryBaseDelaySeconds": 10,
    "RefundRetryJitterSeconds": 5,
    "ReconciliationIntervalSeconds": 60,
    "ReconciliationLockTimeoutSeconds": 30,
    "ReconciliationScanWindowMinutes": 180,
    "NetworkFeeResponsibility": "DeductedFromPool",
    "WebhookEventRetentionDays": 90,
    "BtcPayBaseUrl": "https://btcpay.example.local",
    "BtcPayApiKey": "",
    "BtcPayStoreId": "",
    "WebhookSecret": "dev-webhook-secret",
    "ConnectionString": "Host=localhost;Port=5432;Database=wintowar;Username=postgres;Password=postgres"
  }
}
