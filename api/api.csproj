<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- docs/14-payment-sandbox.md Bölüm 3: testnet BTCPay secret'ları (API key,
         webhook secret) yalnızca `dotnet user-secrets` üzerinden yerel makinede
         tutulur, appsettings.json'a hardcode edilmez. -->
    <UserSecretsId>598c808b-babe-4a14-bdb6-fcc3d3f74bef</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- 06-coding-standards.md "Bağımlılık Disiplini": dotnet-ef migration tooling'i için zorunlu, yalnızca derleme zamanı kullanılır (PrivateAssets), çalışma zamanına dahil edilmez. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- docs/11-auth.md Bölüm 1.4: JWT Bearer authentication (access token doğrulama, API + SignalR). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />
    <!-- docs/11-auth.md Bölüm 1.2 🛠️ kütüphane istisnası: Google id_token doğrulaması resmi kütüphaneyle yapılır. -->
    <PackageReference Include="Google.Apis.Auth" Version="1.69.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data\map.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
